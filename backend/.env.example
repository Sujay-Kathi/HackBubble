# ── Application ───────────────────────────────────────────────────────────
APP_NAME=HackBubble
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-32-char-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackbubble
DB_ECHO=false

# ── Embeddings ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Providers ─────────────────────────────────────────────────────────────
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# Supabase (only needed when AUTH_PROVIDER/STORAGE_PROVIDER is supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# ── LLM ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Scraper ───────────────────────────────────────────────────────────────
SCRAPER_USER_AGENT=HackBubble-Bot/1.0 (+https://github.com/Sujay-Kathi/HackBubble)
SCRAPER_CONCURRENCY=3

# ── Email delivery (leave SMTP_HOST empty to skip sends) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@hackbubble.local
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# ── Background workers ────────────────────────────────────────────────────
WORKERS_ENABLED=false
WORKER_DISPATCH_INTERVAL_SECONDS=30
WORKER_SCRAPE_INTERVAL_SECONDS=900
WORKER_EMBEDDING_BACKFILL_INTERVAL_SECONDS=3600
WORKER_BATCH_SIZE=50

# ── Rate limiting (in-memory, per-process) ────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
