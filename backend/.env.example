# HackBubble Backend Environment Configuration Example

# Application
APP_ENV=development
APP_NAME=HackBubble
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
# For local Docker / Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackbubble
# For SQLite test fallback:
# DATABASE_URL=sqlite+aiosqlite:///./hackbubble.db

# Vector Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Auth Provider (supabase | local)
AUTH_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage Provider (local | supabase | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
SUPABASE_STORAGE_BUCKET=resumes

# AI & LLM Provider (openai | gemini | ollama)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Scraper Settings
SCRAPER_USER_AGENT="HackBubble-Bot/1.0 (+https://github.com/Sujay-Kathi/HackBubble)"
SCRAPER_CONCURRENCY=3
